// ─────────────────────────────────────────────────────────────────────────────
// Prisma Schema – Tennis Tournament App
// ─────────────────────────────────────────────────────────────────────────────
//
// Development  → SQLite  (current)
// Production   → change provider to "postgresql" and update DATABASE_URL
//               in your .env file. Run `prisma migrate deploy` to apply.
//
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // ⚠️  To switch to PostgreSQL:
  //   1. Change `provider` to "postgresql"
  //   2. Update DATABASE_URL in .env  →  postgresql://user:pass@host:5432/dbname
  //   3. npx prisma migrate deploy
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────
// SQLite does not support native Prisma enums — fields are stored as String.
// Valid values are enforced at the application layer via TypeScript types
// (see src/types/enums.ts).
//
// ⚠️  When migrating to PostgreSQL you CAN switch these fields back to proper
//     Prisma enums: replace `String` with the enum type and uncomment the enum
//     definitions below.
//
// enum Role             { ADMIN PLAYER }
// enum TournamentStatus { DRAFT OPEN IN_PROGRESS FINISHED CANCELLED }
// enum Modality         { SINGLES DOUBLES }

// ── Models ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  /// Valid values: "ADMIN" | "PLAYER"
  role         String   @default("PLAYER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  tournaments   Tournament[]   @relation("TournamentCreator")
  registrations Registration[]
  matchesAsP1   Match[]        @relation("Player1")
  matchesAsP2   Match[]        @relation("Player2")
  wonMatches    Match[]        @relation("Winner")
}

model Tournament {
  id              String   @id @default(cuid())
  name            String
  description     String?
  date            DateTime
  location        String
  maxParticipants Int
  /// Valid values: "SINGLES" | "DOUBLES"
  modality        String   @default("SINGLES")
  /// Valid values: "DRAFT" | "OPEN" | "IN_PROGRESS" | "FINISHED" | "CANCELLED"
  status          String   @default("DRAFT")
  prize           String?
  rulesPdfUrl     String?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  createdBy     User           @relation("TournamentCreator", fields: [createdById], references: [id])
  registrations Registration[]
  matches       Match[]
}

model Registration {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String
  createdAt    DateTime @default(now())

  // Relations
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A player can only register once per tournament
  @@unique([tournamentId, userId])
}

model Match {
  id           String   @id @default(cuid())
  tournamentId String
  round        Int // 1 = first round, 2 = second round, etc.
  player1Id    String?
  player2Id    String?
  winnerId     String?
  result       String? // e.g. "6-3 7-5"
  nextMatchId  String? // Self-reference for bracket progression
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  tournament  Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player1     User?      @relation("Player1", fields: [player1Id], references: [id])
  player2     User?      @relation("Player2", fields: [player2Id], references: [id])
  winner      User?      @relation("Winner", fields: [winnerId], references: [id])
  nextMatch   Match?     @relation("BracketNext", fields: [nextMatchId], references: [id])
  prevMatches Match[]    @relation("BracketNext")
}
